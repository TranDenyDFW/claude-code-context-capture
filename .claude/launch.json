{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "c4x-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "c4x-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "c4x.api"
      ],
      "port": 8059
    },
    {
      "name": "c4x-api-fixture",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:C4X_DB='tmp/test.db'; $env:C4X_READ_ONLY='1'; python -m c4x.api --port 8062"
      ],
      "port": 8062
    },
    {
      "name": "c4x-api-dev",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "c4x.api",
        "--port",
        "8061"
      ],
      "port": 8061
    }
  ]
}
